# Copia este archivo como .env (no se sube a GitHub) y rellénalo.
# Los mismos valores van en GitHub → Settings → Secrets and variables → Actions.

# YouTube Data API v3 (Google Cloud). Tu canal se lee del botón de YouTube de index.html.
YT_API_KEY=

# TikTok for Developers → tu app → Client key / Client secret.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# La misma dirección que registraste en Login Kit (tu web publicada). Solo hace falta en .env.
TIKTOK_REDIRECT_URI=

# STATE_KEY (la clave que cifra los tokens de Instagram y TikTok) la añade sola
# "node scripts/conectar.mjs" la primera vez que conectas una cuenta.
